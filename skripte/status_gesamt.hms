! Gesamtstatus: Programme, Systemvariablen, Servicemeldungen, Urlaubsmodus, Heizung - schaltet nichts.
string id; string e; string a; object o; object dp; object cm; object st; string m;
WriteLine("=== PROGRAMME: Name;Aktiv;Zuletzt");
foreach(id, dom.GetObject(ID_PROGRAMS).EnumIDs()) {
  o = dom.GetObject(id);
  if (o) { WriteLine(o.Name() # ";" # o.Active() # ";" # o.ProgramLastExecuteTime()); }
}
WriteLine("=== SYSTEMVARIABLEN: Name;Wert");
foreach(id, dom.GetObject(ID_SYSTEM_VARIABLES).EnumIDs()) {
  o = dom.GetObject(id);
  if (o) { WriteLine(o.Name() # ";" # o.Value()); }
}
WriteLine("=== SERVICEMELDUNGEN: " # dom.GetObject(41).Value());
WriteLine("=== URLAUBSMODUS: " # dom.GetObject("urlaub modus ein").Value());
WriteLine("--- Wandthermostate (Solltemperatur)");
foreach(e, "KEQ0011339=Bad Gaeste\tIEQ0444515=Flur\tKEQ0010690=Girls Bad\tKEQ0011910=Reci\tKEQ0011850=Solarium\tKEQ0009984=Waschraum\tJEQ0457275=Zimmer 1\tJEQ0457264=Zimmer 2\tJEQ0121520=Zimmer 4\tJEQ0121592=Zimmer 6\tKEQ0010505=Zimmer 8") {
  a = e.StrValueByIndex("=", 0);
  dp = dom.GetObject("BidCos-RF." # a # ":2.SETPOINT");
  if (dp) { WriteLine(e.StrValueByIndex("=", 1) # "  " # dp.Value().ToString(1)); }
}
WriteLine("--- Heizkoerperthermostate (Modus / Solltemperatur)");
foreach(e, "OEQ1257004=Kueche\tOEQ1257212=Zimmer 3\tREQ0381230=Zimmer 4\tLEQ1287076=Zimmer 5\tREQ0381224=Zimmer 7") {
  a = e.StrValueByIndex("=", 0);
  cm = dom.GetObject("BidCos-RF." # a # ":4.CONTROL_MODE");
  st = dom.GetObject("BidCos-RF." # a # ":4.SET_TEMPERATURE");
  if (cm && st) {
    m = "?";
    if (cm.Value() == 0) { m = "Auto"; }
    if (cm.Value() == 1) { m = "Manu"; }
    if (cm.Value() == 2) { m = "Party/Urlaub"; }
    if (cm.Value() == 3) { m = "Boost"; }
    WriteLine(e.StrValueByIndex("=", 1) # "  " # m # "  " # st.Value().ToString(1));
  }
}
