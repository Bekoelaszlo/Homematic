! Loescht die optionalen Systemvariablen: HomeControl/myHome-App, Alarmzone 1, Anwesenheit (alle nirgends in Programmen genutzt)
! Erst mit loeschen = false laufen lassen: jede Zeile muss "OK" zeigen.
boolean loeschen = false;
string liste = "12237=myHomeToken\t12238=myHomeLastPushMessage\t12289=myHomeLastPushMessage 1\t1292=Alarmzone 1\t950=Anwesenheit";
string e; string soll; integer id; object o; integer z = 0;
foreach(e, liste) {
  id = e.StrValueByIndex("=", 0).ToInteger();
  soll = e.StrValueByIndex("=", 1);
  o = dom.GetObject(id);
  if (o) {
    if (o.Name() == soll) {
      WriteLine("OK     " # id # " " # soll);
      if (loeschen) { dom.GetObject(ID_SYSTEM_VARIABLES).Remove(id); dom.DeleteObject(id); z = z + 1; }
    } else { WriteLine("ANDERS " # id # " heisst '" # o.Name() # "' - wird NICHT geloescht"); }
  } else { WriteLine("FEHLT  " # id # " " # soll); }
}
if (loeschen) { WriteLine("Geloescht: " # z); } else { WriteLine("PROBELAUF - nichts geloescht"); }
