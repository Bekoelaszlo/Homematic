! Zimmer 6: Verknuepfung Fensterkontakt -> Wandthermostat loeschen und neu anlegen.
! Erst mit ausfuehren = false laufen lassen (zeigt nur den Befehl), dann true.
! Danach: am Fensterkontakt kurz die Taste druecken, damit er die neue Konfiguration abholt.
boolean ausfuehren = false;
string out; string err; string cmd;
cmd = "load tclrpc.so; ";
cmd = cmd # "catch {xmlrpc http://127.0.0.1:2001/ removeLink [list string MEQ1831714:1] [list string JEQ0121592:3]} r1; puts [concat removeLink: $r1]; ";
cmd = cmd # "catch {xmlrpc http://127.0.0.1:2001/ addLink [list string MEQ1831714:1] [list string JEQ0121592:3] [list string Zimmer6Fenster] [list string Fensterkontakt]} r2; puts [concat addLink: $r2]; ";
cmd = cmd # "puts [concat jetzt-verknuepft-mit: [xmlrpc http://127.0.0.1:2001/ getLinkPeers [list string MEQ1831714:1]]]";
if (ausfuehren) {
  system.Exec("echo '" # cmd # "' | tclsh", &out, &err);
  WriteLine(out);
  if (err != "") { WriteLine("FEHLER: " # err); }
} else {
  WriteLine("PROBELAUF - wuerde ausfuehren:");
  WriteLine(cmd);
}
