! Alle Ventilantriebe (HM-CC-VD) automatisch: Oeffnung, letzte Meldung, erreichbar? - schaltet nichts.
! "zuletzt" sollte nur wenige Minuten alt sein; sonst hat die CCU das Ventil seitdem nicht gehoert.
string id; object d; string a; object dp; object ur; object cp; string s;
foreach(id, dom.GetObject(ID_DEVICES).EnumUsedIDs()) {
  d = dom.GetObject(id);
  if (d.HssType() == "HM-CC-VD") {
    a = d.Address();
    dp = dom.GetObject("BidCos-RF." # a # ":1.VALVE_STATE");
    ur = dom.GetObject("BidCos-RF." # a # ":0.UNREACH");
    cp = dom.GetObject("BidCos-RF." # a # ":0.CONFIG_PENDING");
    s = d.Name() # " (" # a # "): ";
    if (dp) { s = s # dp.Value() # " %  zuletzt " # dp.Timestamp(); }
    if (ur) { if (ur.Value()) { s = s # "  NICHT ERREICHBAR"; } }
    if (cp) { if (cp.Value()) { s = s # "  KONFIG AUSSTEHEND"; } }
    if (!d.ReadyConfig()) { s = s # "  IM POSTEINGANG"; }
    WriteLine(s);
  }
}
WriteLine("Servicemeldungen: " # dom.GetObject(41).Value());
