string id; string cid; object d; object ch; string a; string n; integer p; integer z = 0;
foreach(id, dom.GetObject(ID_DEVICES).EnumUsedIDs()) {
  d = dom.GetObject(id);
  a = d.Address();
  p = liste.Find("\t" # a # "=");
  if (p >= 0) {
    n = liste.Substr(p + a.Length() + 2, 80).StrValueByIndex("\t", 0);
    if (d.Name() != n) { WriteLine(a # ": " # d.Name() # " -> " # n); z = z + 1; if (aendern) { d.Name(n); } }
    foreach(cid, d.Channels().EnumUsedIDs()) {
      ch = dom.GetObject(cid);
      a = ch.Address();
      p = liste.Find("\t" # a # "=");
      if (p >= 0) {
        n = liste.Substr(p + a.Length() + 2, 80).StrValueByIndex("\t", 0);
        if (ch.Name() != n) { WriteLine(a # ": " # ch.Name() # " -> " # n); z = z + 1; if (aendern) { ch.Name(n); } }
      }
    }
  }
}
if (aendern) { WriteLine("Umbenannt: " # z); } else { WriteLine("PROBELAUF - wuerde umbenennen: " # z); }
