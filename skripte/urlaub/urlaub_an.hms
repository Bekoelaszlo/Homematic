! Urlaubsmodus AN - als Skript im Programm "Urlaubsmodus" (DANN)
! Wandthermostate mit Ventil: Solltemperatur setzen (gilt im Automatikbetrieb bis zum naechsten Schaltzeitpunkt,
!   deshalb wiederholt das Programm "Urlaub halten" das stuendlich)
! Heizkoerperthermostate: in den manuellen Betrieb mit Urlaubstemperatur (bleibt bis "Urlaub aus")
real t = 16.0;
string a; object dp;
! HM-CC-TC: Bad Gaeste, Flur, Girls Bad, Reci, Solarium, Waschraum, Zimmer 1, 2, 4, 6, 8
foreach(a, "KEQ0011339\tIEQ0444515\tKEQ0010690\tKEQ0011910\tKEQ0011850\tKEQ0009984\tJEQ0457275\tJEQ0457264\tJEQ0121520\tJEQ0121592\tKEQ0010505") {
  dp = dom.GetObject("BidCos-RF." # a # ":2.SETPOINT");
  if (dp) { dp.State(t); }
}
! HM-CC-RT-DN: Kueche, Zimmer 3, 4, 5, 7
foreach(a, "OEQ1257004\tOEQ1257212\tREQ0381230\tLEQ1287076\tREQ0381224") {
  dp = dom.GetObject("BidCos-RF." # a # ":4.MANU_MODE");
  if (dp) { dp.State(t); }
}
